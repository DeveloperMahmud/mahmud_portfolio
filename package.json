    "test:thumbnail-demo": "node --test scripts/thumbnail-demo.test.mjs",
    "test:contrast-demo": "node --test scripts/contrast-demo.test.mjs",
    "test:planner-demo": "node --test scripts/planner-demo.test.mjs",
    "test:brief-demo": "node --test scripts/brief-demo.test.mjs",
    "test:audit-demo": "node --test scripts/audit-demo.test.mjs",
    "test:review-demo": "node --test scripts/review-demo.test.mjs",
