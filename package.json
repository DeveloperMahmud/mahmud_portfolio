    "test:image-safe-zone-engine": "node --test scripts/image-safe-zone-engine.test.mjs",
    "test:design-handoff-engine": "node --test scripts/design-handoff-engine.test.mjs",
    "test:background-inspector-engine": "node --test scripts/background-inspector-engine.test.mjs",
    "test:visual-brief-pdf-engine": "node --test scripts/visual-brief-pdf-engine.test.mjs",
    "test:brand-asset-kit-engine": "node --test scripts/brand-asset-kit-engine.test.mjs",
