    "test:studio-mode": "node --test scripts/studio-mode.test.mjs",
    "test:commercial-case-study": "node --test scripts/commercial-case-study.test.mjs",
    "test:behance-case-studies": "node --test scripts/behance-case-studies.test.mjs",
    "test:preview-experiences": "node --test scripts/preview-experiences.test.mjs",
    "test:service-pages": "node --test scripts/service-pages.test.mjs",
    "test:inquiry-segmentation": "node --test scripts/inquiry-segmentation.test.mjs",
    "test:presentation-mode": "node --test scripts/presentation-mode.test.mjs",
