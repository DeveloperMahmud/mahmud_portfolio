{
  "name": "mahmudul-portfolio-v7",
  "version": "8.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "vercel-build": "prisma generate && node scripts/vercel-migrate.mjs && node scripts/seed-creative-tools.mjs && node scripts/seed-behance-case-studies.mjs && node scripts/seed-preview-experiences.mjs && npm run build",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:behance-case-studies": "node scripts/seed-behance-case-studies.mjs",
    "db:seed:preview-experiences": "node scripts/seed-preview-experiences.mjs",
    "db:seed:creative-tools": "node scripts/seed-creative-tools.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:local": "node scripts/local-smoke-runner.mjs",
    "test:smoke:static": "node scripts/static-smoke.mjs",
    "test:operations": "node --test scripts/operations.test.mjs",
    "test:slider": "node --test scripts/editorial-slider.test.mjs",
    "test:page-studio": "node --test scripts/page-studio.test.mjs",
    "test:creative-lab": "node --test scripts/creative-lab-foundation.test.mjs",
    "test:v2-routes": "node --test scripts/v2-routes.test.mjs",
    "test:v2-case-study": "node --test scripts/v2-case-study-contract.test.mjs",
    "test:creative-tool-schema": "node --test scripts/creative-tool-schema.test.mjs",
