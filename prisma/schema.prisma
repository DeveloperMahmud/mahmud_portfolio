generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CreativeToolKind {
  FLAGSHIP
  MINI
}

enum CreativeToolProductStatus {
  PLANNED
  PREVIEW
  BETA
  LIVE
  ARCHIVED
}

enum CreativeToolDemoMode {
  CONCEPT
  SAMPLE_INTERACTIVE
  ACTUAL
}

enum CreativeToolActionBehavior {
  AUTO
  DEMO
  LIVE
  DETAILS
}

enum CreativeToolLinkTarget {
  SAME_TAB
  NEW_TAB
}

enum UserRole {
  ADMIN
  EDITOR
  WRITER
  MODERATOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id                String        @id @default(cuid())
  title             String
  slug              String        @unique
  category          String
  service           String?
  type              String?
  client            String?
  year              Int?
  role              String?
  description       String?
  coverImage        String?
  gallery           Json          @default("[]")
  challenge         String?
  approach          String?
  process           String?
  results           String?
  deliverables      String[]      @default([])
  tools             String[]      @default([])
  featured          Boolean       @default(false)
  sliderEnabled     Boolean       @default(true)
  sliderTransition  String        @default("AUTO")
  sortOrder         Int           @default(0)
  status            ProjectStatus @default(DRAFT)
  visibility        Visibility    @default(PUBLIC)
  accessTokenHash   String?
  clientOnly        Boolean       @default(false)
  clientExpiresAt   DateTime?
  scheduledAt       DateTime?
  seoTitle          String?
  seoDescription    String?
  liveUrl           String?
  industry          String?
  projectSubtitle   String?
  credits           Json          @default("[]")
  projectBlocks     Json          @default("[]")
  showOnHomepage    Boolean       @default(true)
  homepageOrder     Int           @default(0)
  homepageLayout    String        @default("STANDARD")
  homepageTitle     String?
  homepageSubtitle  String?
  homepageImage     String?
  sliderImage       String?
  sliderMobileImage String?
  sliderTitle       String?
  sliderHeadline    String?
  sliderDescription String?
  sliderCtaLabel    String?
  sliderCtaUrl      String?
  sliderTextAlign   String        @default("LEFT")
  sliderOverlay     Int           @default(35)
  sliderFocalPoint  String        @default("50% 50%")
  sliderThumbnail   String?
  sliderImageAlt    String?
  sliderReflection  String        @default("INHERIT")
  sliderReflectionIntensity String?
  ogImage           String?
  ogTitle           String?
  ogDescription     String?
  canonicalUrl      String?
  noIndex           Boolean       @default(false)
  noFollow          Boolean       @default(false)
  includeSitemap    Boolean       @default(true)
  focusTopic        String?
  publicModifiedAt  DateTime?
  relatedProjectIds String[]      @default([])
  relatedContentIds String[]      @default([])
  nextProjectId     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  deletedBy         String?
  resultMetrics     ProjectMetric[]
  analyticsEvents   AnalyticsEvent[]

  @@index([status, visibility])
  @@index([featured, sortOrder])
}

model ProjectMetric {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  value       String?
  prefix      String?
  suffix      String?
  beforeValue String?
  afterValue  String?
  publicNote  String?
  sourceNote  String?
  verified    Boolean  @default(false)
  visible     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, sortOrder])
  @@index([projectId, verified, visible])
}

model CreativeTool {
  id                    String                     @id @default(cuid())
  canonicalId           String?                    @unique
  systemSeeded          Boolean                    @default(false)
  seedVersion           Int?
  slug                  String                     @unique
  publishedSlug         String?                    @unique
  kind                  CreativeToolKind
  category              String                     @default("GENERAL")
  tags                  String[]                   @default([])
  title                 String
  subtitle              String?
  shortDescription      String?
  overview              String?
  problemStatement      String?
  audience              String[]                   @default([])
  featureBullets        String[]                   @default([])
  proposedInputs        String[]                   @default([])
  proposedOutputs       String[]                   @default([])
  limitations           String[]                   @default([])
  iconKey               String?
  coverImage            String?
  galleryImages         Json                       @default("[]")
  pageBlocks            Json                       @default("[]")
  productStatus         CreativeToolProductStatus  @default(PLANNED)
  demoMode              CreativeToolDemoMode       @default(CONCEPT)
  demoNotice            String?
  visibility            Visibility                 @default(PUBLIC)
  visible               Boolean                    @default(true)
  featured              Boolean                    @default(false)
  sortOrder             Int                        @default(0)
  demoUrl               String?
  liveUrl               String?
  documentationUrl      String?
  liveUrlVerifiedAt     DateTime?
  primaryLabel          String?
  primaryBehavior       CreativeToolActionBehavior @default(AUTO)
  primaryTarget         CreativeToolLinkTarget     @default(SAME_TAB)
  primaryStyle          String?
  secondaryLabel        String?
  secondaryBehavior     CreativeToolActionBehavior?
  secondaryUrl          String?
  secondaryTarget       CreativeToolLinkTarget     @default(SAME_TAB)
  secondaryStyle        String?
  status                ProjectStatus              @default(DRAFT)
  publishedSnapshot     Json?
  publishedAt           DateTime?
  scheduledAt           DateTime?
  publicModifiedAt      DateTime?
  seoTitle              String?
  seoDescription        String?
  ogImage               String?
  canonicalUrl          String?
  noIndex               Boolean                    @default(false)
  noFollow              Boolean                    @default(false)
  includeSitemap        Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  deletedAt             DateTime?
  deletedBy             String?

  @@index([status, visibility, visible, scheduledAt])
  @@index([kind, productStatus, sortOrder])
  @@index([category, sortOrder])
  @@index([featured, visible, sortOrder])
  @@index([productStatus, visible])
  @@index([deletedAt, updatedAt])
}

model AnalyticsEvent {
  id             String   @id @default(cuid())
  eventType      String
  occurredAt     DateTime @default(now())
  path           String
  normalizedPath String
  pageTitle      String?
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  visitorHash    String?
  sessionHash    String?
  referrerHost   String?
  source         String?
  deviceType     String?
  countryCode    String?
  engagementMs   Int      @default(0)
  metadata       Json     @default("{}")

  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([projectId, occurredAt])
  @@index([normalizedPath, occurredAt])
  @@index([visitorHash, occurredAt])
  @@index([sessionHash, occurredAt])
}

model AnalyticsDaily {
  id             String   @id @default(cuid())
  date           DateTime
  dimensionType  String   @default("OVERALL")
  dimensionValue String   @default("ALL")
  uniqueVisitors BigInt   @default(0)
  sessions       BigInt   @default(0)
  pageViews      BigInt   @default(0)
  projectViews   BigInt   @default(0)
  ctaClicks      BigInt   @default(0)
  inquiries      BigInt   @default(0)
  engagementMs   BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date, dimensionType, dimensionValue])
  @@index([date, dimensionType])
}

model Brand {
  id         String   @id @default(cuid())
  name       String   @unique
  logoAsset  String?
  logoDark   String?
  url        String?
  industry   String?
  description String?
  featured   Boolean  @default(false)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
}


model Content {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  type           String   @default("BLOG")
  category       String?
  excerpt        String?
  body           String
  coverImage     String?
  gallery        Json     @default("[]")
  tags           String[] @default([])
  author         String?
  seoTitle       String?
  seoDescription String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  canonicalUrl   String?
  noIndex        Boolean  @default(false)
  noFollow       Boolean  @default(false)
  includeSitemap Boolean  @default(true)
  focusTopic     String?
  references     Json     @default("[]")
  relatedProjectIds String[] @default([])
  relatedContentIds String[] @default([])
  publicModifiedAt DateTime?
  status         ProjectStatus @default(DRAFT)
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  deletedBy      String?

  @@index([status, publishedAt])
  @@index([featured, sortOrder])
}


model SiteSettings {
  id                 String   @id @default(cuid())
  siteName           String   @default("Mahmudul Hassan")
  title              String   @default("Creative Designer")
  email              String?
  inquiryRecipientEmail String?
  inquirySubject     String?
  phone              String?
  location           String?
  availability       Boolean  @default(true)
  availabilityLabel  String?  @default("AVAILABLE FOR SELECT PROJECTS")
  linkedin           String?
  behance            String?
  dribbble           String?
  instagram          String?
  github             String?
  metaTitle          String?
  metaDescription    String?
  ogImage            String?
  heroImage          String?
  heroLeadText       String   @default("I DESIGN")
  heroTypewriterPhrases Json   @default("[\"BRANDS THAT SELL.\"]")
  typewriterConfig   Json     @default("{}")
  homepageOrder      String?
  sliderConfig       Json     @default("{}")
  skillsConfig       Json     @default("[]")
  heroConfig         Json     @default("{}")
  capabilitiesConfig Json     @default("[]")
  amazonConfig       Json     @default("{}")
  statementConfig    Json     @default("{}")
  aboutConfig        Json     @default("{}")
  socialLinks        Json     @default("[]")
  navigationConfig   Json     @default("[]")
  footerConfig       Json     @default("{}")
  seoConfig          Json     @default("{}")
  inquiryConfig      Json     @default("{}")
  pageStudioConfig   Json     @default("{}")
  featureFlags       Json     @default("{}")
  themeConfig        Json     @default("{}")
  securityConfig     Json     @default("{}")
  updatedAt          DateTime @updatedAt
}

model CustomPage {
  id                String           @id @default(cuid())
  title             String
  slug              String           @unique
  path              String           @unique
  status            ProjectStatus    @default(DRAFT)
  visibility        Visibility       @default(PUBLIC)
  templateKey       String?
  blocks            Json             @default("[]")
  navbarPresetId    String?
  navbarPreset      NavigationPreset? @relation(fields: [navbarPresetId], references: [id], onDelete: SetNull)
  seoTitle          String?
  seoDescription    String?
  ogImage           String?
  canonicalUrl      String?
  noIndex           Boolean          @default(false)
  noFollow          Boolean          @default(false)
  includeSitemap    Boolean          @default(true)
  publishedPath     String?          @unique
  publishedSnapshot Json?
  publishedAt       DateTime?
  scheduledAt       DateTime?
  publicModifiedAt  DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  taxonomy          PageTaxonomyAssignment[]

  @@index([status, visibility])
  @@index([navbarPresetId])
  @@index([deletedAt, updatedAt])
}

model PageTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  category    String   @default("GENERAL")
  thumbnail   String?
  blocks      Json     @default("[]")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, category])
}

model ReusableBlock {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  category    String   @default("CONTENT")
  mode        String   @default("GLOBAL")
  block       Json
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, category])
}

model NavigationPreset {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  isGlobal    Boolean      @default(false)
  enabled     Boolean      @default(true)
  items       Json         @default("[]")
  styles      Json         @default("{}")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pages       CustomPage[]

  @@index([enabled, isGlobal])
}

model TaxonomyTerm {
  id          String                     @id @default(cuid())
  name        String
  slug        String
  type        String                     @default("PAGE_TAG")
  description String?
  parentId    String?
  parent      TaxonomyTerm?              @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    TaxonomyTerm[]              @relation("TaxonomyTree")
  sortOrder   Int                        @default(0)
  active      Boolean                    @default(true)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  pages       PageTaxonomyAssignment[]

  @@unique([type, slug])
  @@index([type, active, sortOrder])
  @@index([parentId])
}

model PageTaxonomyAssignment {
  pageId     String
  termId     String
  page       CustomPage   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  term       TaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  assignedAt DateTime     @default(now())

  @@id([pageId, termId])
  @@index([termId])
}

model TrustedEmbedSource {
  id              String   @id @default(cuid())
  name            String
  origin          String   @unique
  enabled         Boolean  @default(true)
  allowIframe     Boolean  @default(true)
  allowRemoteJson Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
}

model SeoSettings {
  id                    String   @id @default(cuid())
  siteName              String   @default("Mahmudul Hassan")
  defaultTitle          String?
  titleTemplate         String   @default("%s — Mahmudul Hassan")
  defaultDescription    String?
  defaultOgTitle        String?
  defaultOgDescription  String?
  defaultOgImage        String?
  twitterCard           String   @default("summary_large_image")
  canonicalOrigin       String?
  defaultIndex          Boolean  @default(true)
  defaultFollow         Boolean  @default(true)
  siteLanguage          String   @default("en")
  siteLocale            String   @default("en_US")
  googleVerification    String?
  bingVerification      String?
  crawlerConfig         Json     @default("{}")
  socialProfiles        String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model EntityProfile {
  id                String   @id @default(cuid())
  publicName        String   @default("Mahmudul Hassan")
  alternateName     String?
  professionalTitle String?
  shortBio          String?
  longBio           String?
  portrait          String?
  profilePath       String   @default("/#about")
  location          String?
  expertise         String[] @default([])
  services          String[] @default([])
  socialProfiles    String[] @default([])
  contactPath       String   @default("/#contact")
  stableIdentifier  String   @default("person")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model RedirectRule {
  id          String   @id @default(cuid())
  sourcePath  String   @unique
  destination String
  statusCode  Int      @default(301)
  enabled     Boolean  @default(true)
  reason      String?
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sourcePath])
}

model SeoAuditIssue {
  id        String   @id @default(cuid())
  pageType  String
  pageId    String?
  url       String
  code      String
  severity  String
  message   String
  details   Json     @default("{}")
  resolved  Boolean  @default(false)
  checkedAt DateTime @default(now())

  @@index([severity, resolved])
  @@index([pageType, pageId])
}

model IndexNowSubmission {
  id          String   @id @default(cuid())
  url         String
  status      String   @default("QUEUED")
  responseCode Int?
  error       String?
  attempts    Int      @default(0)
  submittedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([url, createdAt])
  @@index([status, createdAt])
}

model Testimonial {
  id         String   @id @default(cuid())
  client     String
  company    String?
  role       String?
  quote      String
  photo      String?
  projectId  String?
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  @@index([published, featured, sortOrder])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  label      String?
  actorId    String?
  result     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, entity, createdAt])
}


model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  service     String?
  company     String?
  projectType String?
  budget      String?
  timeline    String?
  message     String
  attachment  String?
  status      String   @default("NEW")
  internalNotes String?
  priority      String   @default("NORMAL")
  tags          String[] @default([])
  assigneeId    String?
  followUpAt    DateTime?
  estimatedValue Int?
  currency      String   @default("USD")
  proposalStatus String?
  proposalDate  DateTime?
  outcomeReason String?
  anonymizedAt  DateTime?
  readAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

model InquiryActivity {
  id        String   @id @default(cuid())
  inquiryId String
  action    String
  note      String?
  createdAt DateTime @default(now())

  @@index([inquiryId, createdAt])
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}


model ProjectReview {
  id          String   @id @default(cuid())
  projectId   String
  clientName  String
  clientEmail String?
  decision    String   @default("CHANGES_REQUESTED")
  comment     String?
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

model Media {
  id String @id @default(cuid())
  key String @unique
  url String
  provider String @default("local")
  originalName String
  filename String
  mimeType String
  size Int @default(0)
  checksum String? @unique
  visibility String @default("PUBLIC")
  status String @default("COMPLETE")
  derivatives Json @default("[]")
  width Int?
  height Int?
  alt String?
  title String?
  description String?
  caption String?
  creator String?
  credit String?
  decorative Boolean @default(false)
  tags String[] @default([])
  folder String?
  keep Boolean @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([mimeType])
  @@index([createdAt])
}

model ContentRevision {
  id           String   @id @default(cuid())
  resourceType String
  resourceId   String
  revision     Int
  snapshot     Json
  summary      String?
  sourceAction String?
  actorId      String?
  createdAt    DateTime @default(now())

  @@unique([resourceType, resourceId, revision])
  @@index([resourceType, resourceId, createdAt])
}

model BackupRecord {
  id             String   @id @default(cuid())
  formatVersion  String
  status         String
  checksum       String?
  includedData   Json
  recordCounts   Json?
  payload        Json?
  requestedById  String?
  includesPrivateData Boolean @default(false)
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  expiresAt      DateTime?

  @@index([status, createdAt])
}

model SystemCheck {
  id        String   @id @default(cuid())
  service   String
  status    String
  message   String?
  metadata  Json     @default("{}")
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
}

model EmailDelivery {
  id            String   @id @default(cuid())
  inquiryId     String?
  type          String
  provider      String?
  providerId    String?
  status        String   @default("NOT_REQUESTED")
  attemptCount  Int      @default(0)
  lastErrorCode String?
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([inquiryId, createdAt])
  @@index([status, nextRetryAt])
}

model ErrorIncident {
  id          String   @id @default(cuid())
  fingerprint String?
  source      String
  environment String
  release     String?
  message     String
  context     Json     @default("{}")
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([resolved, createdAt])
  @@index([source, createdAt])
}

model PreviewToken {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  resourceType String
  resourceId   String
  createdById  String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId, expiresAt])
}
