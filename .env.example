# Local development. Vercel sets NODE_ENV and VERCEL_* automatically.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mahmudul_portfolio?schema=public
APP_ORIGIN=http://localhost:8787
ENABLE_DEMO_CONTENT=false
# Required in production: generate at least 32 cryptographically random bytes.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-seeding
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Vercel server uploads are safely capped by code at 4,000,000 bytes.
# Keep production originals below that limit; local/S3 workflows may use this higher ceiling.
MAX_UPLOAD_BYTES=25000000
MEDIA_STORAGE_QUOTA_BYTES=1073741824
STRICT_STORAGE_QUOTA=false
BLOB_READ_WRITE_TOKEN=

# Optional emergency kill switch. Normal Page Studio controls live in Admin → Control Center.
PAGE_STUDIO_EMERGENCY_DISABLED=false
# Optional GitHub-backed media storage (useful for Vercel without paid object storage)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_MEDIA_DIR=portfolio/uploads
GITHUB_PUBLIC_BASE_URL=

# Inquiry email delivery (Resend REST API — no extra npm package required)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Mahmudul Hassan
INQUIRY_NOTIFICATION_EMAIL=
TURNSTILE_SECRET_KEY=

# Privacy-focused first-party analytics. Enable it from Admin → Control Center.
ANALYTICS_TRACK_LOCAL=false
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_SALT=replace-with-a-separate-random-secret-at-least-16-characters

# SEO, indexing and optional search integrations
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_PROPERTY=
INDEXNOW_KEY=
# Legacy variables may seed defaults on an existing install; Control Center owns runtime switches.
SEO_AUDIT_ENABLED=true
LLMS_TXT_ENABLED=false

# Operations, reliability and recovery
BACKUP_EXPORT_ENABLED=true
BACKUP_RETENTION_DAYS=30
REVISION_RETENTION_COUNT=50
EMAIL_RETRY_MAX_ATTEMPTS=3
ERROR_MONITORING_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
